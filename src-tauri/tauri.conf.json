{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicServer",
  "version": "1.1.0",
  "identifier": "com.musicserver.desktop",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare_tauri_runtime.ps1",
    "devUrl": "http://127.0.0.1:8790",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare_tauri_runtime.ps1",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "desktop-start.html",
        "title": "MusicServer",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      },
      {
        "label": "taskbar-player",
        "url": "taskbar-player.html",
        "title": "MusicServer \u4efb\u52a1\u680f\u6b4c\u8bcd",
        "width": 540,
        "height": 74,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/runtime/**/*"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
