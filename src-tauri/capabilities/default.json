{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window default capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "allow-pick-folder",
    "allow-open-folder",
    "allow-restart-desktop",
    "allow-restore-backup"
  ]
}
